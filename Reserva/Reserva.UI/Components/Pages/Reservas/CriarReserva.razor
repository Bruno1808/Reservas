@page "/criarreserva"


@inject HttpClient Http

@inject NavigationManager Navigation

<h3>Criar Reserva</h3>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @ref="form" @bind-IsValid="@formValido" Spacing="4">

                <MudSelect
                           T="int"
                           Required="true"
                           @bind-Value="novaReserva.LaboratorioId" 
                           Label="Selecione o Laboratorio" Variant="Variant.Outlined"
                           RequiredError="Selecione um laboratório para continuar!">
                    @if (listaLaboratorios == null || !listaLaboratorios.Any())
                {
                    <MudSelectItem T="int" Value="0" Disabled="true">Carregando laboratórios...</MudSelectItem>
                }
                else
                {
                    @foreach (var lab in listaLaboratorios)
                    {
                        <MudSelectItem T="int" Value="@lab.Id">@lab.Nome (Capacidade: @lab.Capacidade)</MudSelectItem>
                    }
                }                    
                </MudSelect>
                <MudSelect T="int"
                           Required="true"
                           @bind-Value="novaReserva.UsuarioId"
                           Label="Selecione o Usuario" Variant="Variant.Outlined"
                           RequiredError="Selecione um Usuario para continuar!">
                    @if (listaUsuarios == null || !listaUsuarios.Any())
                    {
                        <MudSelectItem T="int" Value="0" Disabled="true">Carregando Usuario...</MudSelectItem>
                    }
                    else
                    {
                        @foreach (var usi in listaUsuarios)
                        {
                            <MudSelectItem T="int" Value="@usi.Id">@usi.Nome</MudSelectItem>
                        }
                    }
                </MudSelect>
                <MudItem xs="12" sm="5">
                <MudStack>
                <MudDatePicker Label="Data Inicial"
                               Date="DataSelecionadaInicio"
                               DateChanged="OnDataChangedInicio"
                               Placeholder="Selecione a data"
                               Editable="true"
                               Color="Color.Primary"
                               Variant="Variant.Outlined" />

               
                    <MudTimePicker Label="Horário"
                                   Time="HoraSelecionadaInicio"
                                   TimeChanged="OnHoraChangedInicio"
                                   Placeholder="Selecione a hora"
                                   Color="Color.Secondary"
                                   Variant="Variant.Outlined"
                                   AmPm="false" />
                </MudStack>

                    <MudStack>
                        <MudDatePicker Label="Data Inicial"
                                       Date="DataSelecionadaFinal"
                                       DateChanged="OnDataChangedFinal"
                                       Placeholder="Selecione a data"
                                       Editable="true"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined" />

               
                        <MudTimePicker Label="Horário"
                                       Time="HoraSelecionadaFinal"
                                       TimeChanged="OnHoraChangedFinal"
                                       Placeholder="Selecione a hora"
                                       Color="Color.Secondary"
                                       Variant="Variant.Outlined"
                                       AmPm="false" />
                    </MudStack>
                </MudItem>

            </MudForm>
        </MudPaper>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   onclick="CadastrarReserva"
                   Class="ml-auto">
            Cadastrar
        </MudButton>
    </MudItem>

</MudGrid>

@code {

    public MensagemAlerta mensagemAlerta { get; set; }
    private Reservas novaReserva = new Reservas() { Status = Domain.Enum.Status.CONFIRMADO };
    private MudForm form;
    private bool formValido;
    private bool _isProcessing = false;
    private bool _loading = true;
    private List<Laboratorios> listaLaboratorios = new();
    private List<Usuario> listaUsuarios = new();
    private DateTime DataHoraCombinadaInicio { get; set; } = DateTime.Now;
    private DateTime? DataSelecionadaInicio => DataHoraCombinadaInicio.Date;
    private TimeSpan? HoraSelecionadaInicio => DataHoraCombinadaInicio.TimeOfDay;
    private DateTime DataHoraCombinadaFinal { get; set; } = DateTime.Now;
    private DateTime? DataSelecionadaFinal => DataHoraCombinadaFinal.Date;
    private TimeSpan? HoraSelecionadaFinal => DataHoraCombinadaFinal.TimeOfDay;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BuscarLaboratorio();
            await BuscarUsuario();
        }
    }
    private async Task BuscarLaboratorio()
    {
        try
        {
            _loading = true;
            // Força o MudBlazor a mostrar o estado visual de "Carregando"
            await InvokeAsync(StateHasChanged);

            // 2. Chame exatamente o endpoint que você testou no Postman
            var resposta = await Http.GetFromJsonAsync<List<Laboratorios>>("api/Laboratorio");

            if (resposta != null)
            {
                listaLaboratorios = resposta;
            }
        }
        catch (Exception ex)
        {
            // Se a API falhar, o Snackbar vai te avisar na tela o motivo real
            Snackbar.Add($"Erro na API: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            // Força o MudBlazor a sumir com o "Carregando" e desenhar as linhas da tabela
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BuscarUsuario()
    {
        try
        {
            _loading = true;
            // Força o MudBlazor a mostrar o estado visual de "Carregando"
            await InvokeAsync(StateHasChanged);

            // 2. Chame exatamente o endpoint que você testou no Postman
            var resposta = await Http.GetFromJsonAsync<List<Usuario>>("api/Usuario");

            if (resposta != null)
            {
                listaUsuarios = resposta;
            }
        }
        catch (Exception ex)
        {
            // Se a API falhar, o Snackbar vai te avisar na tela o motivo real
            Snackbar.Add($"Erro na API: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            // Força o MudBlazor a sumir com o "Carregando" e desenhar as linhas da tabela
            await InvokeAsync(StateHasChanged);
        }
    }



    // Propriedades auxiliares para os componentes do MudBlazor


    // Atualiza apenas a parte da Data preservando as horas anteriores
    private void OnDataChangedInicio(DateTime? novaData)
    {
        if (novaData.HasValue)
        {
            DataHoraCombinadaInicio = novaData.Value.Date + (HoraSelecionadaInicio ?? TimeSpan.Zero);
        }
    }

    // Atualiza apenas a parte da Hora preservando a data anterior
    private void OnHoraChangedInicio(TimeSpan? novaHora)
    {
        if (novaHora.HasValue)
        {
            DataHoraCombinadaInicio = (DataSelecionadaInicio ?? DateTime.Today) + novaHora.Value;
        }
    }


    private void OnDataChangedFinal(DateTime? novaData)
    {
        if (novaData.HasValue)
        {
            DataHoraCombinadaFinal = novaData.Value.Date + (HoraSelecionadaFinal ?? TimeSpan.Zero);
        }
    }

    // Atualiza apenas a parte da Hora preservando a data anterior
    private void OnHoraChangedFinal(TimeSpan? novaHora)
    {
        if (novaHora.HasValue)
        {
            DataHoraCombinadaFinal = (DataSelecionadaFinal ?? DateTime.Today) + novaHora.Value;
        }
    }

    private async Task CadastrarReserva()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Por favor, corrija os erros do formulário.", Severity.Warning);
            return;
        }

        try
        {
            _isProcessing = true;
            await InvokeAsync(StateHasChanged);

            novaReserva.DataInicio = DataHoraCombinadaInicio;
            novaReserva.DataFinal = DataHoraCombinadaFinal;

            var resposta = await Http.PostAsJsonAsync("api/ReservasLab", novaReserva);

            // ✅ CORRIGIDO: O 'if' agora funciona de verdade e não está mais comentado
            if (resposta.IsSuccessStatusCode)
            {
                Snackbar.Add("Reserva cadastrada com sucesso!", Severity.Success);
                Navigation.NavigateTo("/reservaspage");
            }
            else
            {
                // Se cair aqui, a API recusou o objeto. O Snackbar vai mostrar o motivo real (ex: validação do banco)
                var erroDetalhado = await resposta.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro ao salvar: {erroDetalhado}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na API: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
 