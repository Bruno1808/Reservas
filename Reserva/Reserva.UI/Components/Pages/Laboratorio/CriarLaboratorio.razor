@page "/criarlaboratorio"


@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Criar Laboratório</h3>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @ref="form" @bind-IsValid="@formValido" Spacing="4">
                <MudTextField T="string" 
                              Label="Nome Do Laboratorio" 
                              @bind-Value="novoLaboratorio.Nome" 
                              Required="true"
                              RequiredError="O nome do Laboratorio é obrigatório!" />
                              
                <MudTextField T="int" 
                              Label="Capacidade" 
                              @bind-Value="novoLaboratorio.Capacidade" 
                              Required="true"
                              RequiredError="A capacidade do laboratorio é obrigatória!" />
            </MudForm>
        </MudPaper>
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="CadastrarLaboratorio"
                   Class="ml-auto">
            Cadastrar
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    private Laboratorios novoLaboratorio = new Laboratorios() ;
    private MudForm form;
    private bool formValido;
    private bool _isProcessing = false;
    public MensagemAlerta mensagemAlerta { get; set; }
    
    private async Task CadastrarLaboratorio()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Por favor, corrija os erros do formulário.", Severity.Warning);
            return;
        }
        
        try
        {
            _isProcessing = true;
            await InvokeAsync(StateHasChanged);
            
            // Faz o envio para a API
            var resposta = await Http.PostAsJsonAsync("api/Laboratorio", novoLaboratorio);
            
            // ✅ CORRIGIDO: O 'if' agora funciona de verdade e não está mais comentado
            if (resposta.IsSuccessStatusCode)
            {
                Snackbar.Add("Laboratório cadastrado com sucesso!", Severity.Success);
                Navigation.NavigateTo("/laboratoriopage");
            }
            else
            {
                // Se cair aqui, a API recusou o objeto. O Snackbar vai mostrar o motivo real (ex: validação do banco)
                var erroDetalhado = await resposta.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro ao salvar: {erroDetalhado}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na API: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    }